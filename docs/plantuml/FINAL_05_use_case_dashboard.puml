@startuml
left to right direction
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FBFC
  BorderColor #0F6B78
  FontSize 15
}

title Use case chi tiết: Xem dashboard phân tích

actor "Seller" as Seller

usecase "Xem dashboard\nphân tích" as Main
usecase "Xem thống kê\ntổng quan" as Summary
usecase "Xem review\ncần chú ý" as Attention
usecase "Xem điểm\nđộ tin cậy" as Trust
usecase "Lọc review\ntheo số sao" as Filter
usecase "Xem bằng chứng\nhình ảnh" as Evidence
usecase "Xem gợi ý\nhành động" as Action

Seller --> Main

Main ..> Summary : <<include>>
Main ..> Attention : <<include>>
Main ..> Trust : <<include>>
Filter ..> Main : <<extend>>
Evidence ..> Attention : <<extend>>
Action ..> Attention : <<extend>>
@enduml
